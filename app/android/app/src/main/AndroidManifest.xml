<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      READ ONLY, AND OPTIONAL.

      Searching the phone book inside the app is what turns signing on a crew
      of twelve from twelve forms into one screen, and that genuinely needs
      this permission. It is requested when the farmer taps "add from my phone
      book" and never at launch: a farmer who has just opened a farm ledger for
      the first time has no idea why it wants their contacts, and a refusal is
      harder to recover than a question never asked.

      A refusal is not a dead end. ACTION_PICK needs no permission at all — the
      picker runs in the system's process and hands back only the one person
      chosen — so that route stays available and the sheet offers it.

      WRITE_CONTACTS IS DELIBERATELY ABSENT. The off-the-shelf plugin bundles
      read and write into one permission alias and will not proceed until both
      are granted, which is why that dependency was removed rather than used.
      Nothing in this app ever writes a contact, and the Play listing should
      not say it might.

      Nothing read here is transmitted anywhere. There is no server.
    -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!--
      PHOTOGRAPHING A BILL.
      Asked the first time the camera button is tapped, never at launch. The
      gallery route needs no permission at all on modern Android — it goes
      through the system photo picker, which hands back the one image chosen —
      so a farmer who refuses the camera can still attach a slip.

      No storage permission is declared. Nothing is written to shared storage;
      the photo is downscaled and kept inside the app's own database.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

</manifest>
